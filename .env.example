BOT_TOKEN=
TELEGRAM_CACHE_CHAT_ID=

OWNER_ID=

DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

TEMP_DIR=./temp
# Free-space floor checked before each fresh acquisition (256 MiB).
TEMP_DISK_MIN_FREE_BYTES=268435456
# Conservative stale-artifact sweep: every 10 minutes, delete only proven unowned roots older than 1 hour.
TEMP_CLEANUP_INTERVAL_SECONDS=600
TEMP_ARTIFACT_STALE_AFTER_SECONDS=3600
DOWNLOAD_TIMEOUT_SECONDS=600
TRANSCODE_TIMEOUT_SECONDS=300
FFMPEG_BINARY=
FFPROBE_BINARY=

DOWNLOAD_WORKERS_DEFAULT=2
DOWNLOAD_WORKERS_MAX=8

UPLOAD_WORKERS_DEFAULT=3
UPLOAD_WORKERS_MAX=10

QUEUE_MAX_SIZE=1000
TELEGRAM_DELIVERY_WORKERS=4
TELEGRAM_DELIVERY_MAX_ATTEMPTS=3

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ru

INTERNAL_API_ENABLED=false
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_PORT=8081
INTERNAL_API_TOKEN=

APP_LOG_LEVEL=INFO

